# Public URL of the deployed site (used for canonical links, sitemap, OG tags)
NEXT_PUBLIC_SITE_URL=https://elitecars-korea.ru

# ---------------------------------------------------------------------------
# Admin panel — /super/secret/admin
# Login and password are compared in constant time; password must be >= 8 chars.
# ADMIN_SESSION_SECRET is optional extra entropy for the session cookie signature
# (changing the password already invalidates all sessions).
ADMIN_LOGIN=
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=

# ---------------------------------------------------------------------------
# Vercel Blob — stores the catalogue, gallery photos, video links and leads (CRM).
# Vercel → Storage → Create → Blob (choose *public* access) → Connect to project.
# Tick "Add a read-write token env var" so BLOB_READ_WRITE_TOKEN is set: it is required
# for direct browser uploads from the admin panel. Locally: copy it into .env.local.
# Without it the app falls back to writing files into public/uploads/ (dev only).
BLOB_READ_WRITE_TOKEN=

# Lead form delivery via Telegram bot (optional; leads are always saved to the CRM)
# 1. Create a bot with @BotFather and copy the token
# 2. Add the bot to a group/chat and get the chat id (e.g. via @userinfobot or getUpdates)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Analytics & webmaster verification (optional)
NEXT_PUBLIC_YM_ID=
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_YANDEX_VERIFICATION=
