# Public URL of the deployed site (used for canonical links, sitemap, OG tags)
NEXT_PUBLIC_SITE_URL=https://koravto.ru

# Lead form delivery via Telegram bot (optional; leads are logged to console if unset)
# 1. Create a bot with @BotFather and copy the token
# 2. Add the bot to a group/chat and get the chat id (e.g. via @userinfobot or getUpdates)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Analytics & webmaster verification (optional)
NEXT_PUBLIC_YM_ID=
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_YANDEX_VERIFICATION=
